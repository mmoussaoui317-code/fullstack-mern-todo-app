<!DOCTYPE html>
<html>
<head>
    <title>XSS Test Page</title>
</head>
<body>
    <h1>Test The Security XSS</h1>
    
    <form id="testForm">
        <textarea id="payload" rows="4" cols="50">
            Enter payloads XSS here to test:
            &lt;script&gt;alert('XSS')&lt;/script&gt;
            &lt;img src="x" onerror="alert(1)"&gt;
            &lt;a href="javascript:alert('XSS')"&gt;Click&lt;/a&gt;
        </textarea>
        <br>
        <button type="button" onclick="testSanitizer()">Test</button>
    </form>
    
    <div id="result"></div>
    
    <script>
    async function testSanitizer() {
        const payload = document.getElementById('payload').value;
        
        try {
            const response = await fetch('http://localhost:5000/api/test-xss', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ input: payload })
            });
            
            const result = await response.json();
            document.getElementById('result').innerHTML = `
                <h3>result:</h3>
                <p><strong>Entry:</strong> ${escapeHtml(payload)}</p>
                <p><strong>Output:</strong> ${escapeHtml(result.cleaned)}</p>
                <p><strong>Security:</strong> ${result.isSafe ? '✅' : '❌'}</p>
            `;
        } catch (error) {
            document.getElementById('result').innerHTML = `Error: ${error.message}`;
        }
    }
    
    function escapeHtml(text) {
        return text
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;")
            .replace(/'/g, "&#039;");
    }
    </script>
</body>
</html>


